# LINEデベロッパーコンソールから取得
LINE_CHANNEL_SECRET=ここにLINEのChannel Secretを貼る
LINE_CHANNEL_ACCESS_TOKEN=ここにLINEのChannel Access Tokenを貼る

# Anthropicコンソールから取得
ANTHROPIC_API_KEY=ここにAnthropicのAPIキーを貼る

# --- スケジューラ機能 ---

# このアプリの公開URL（OAuthコールバック・予約URLの生成に使用）
# 例: https://your-app.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Google Cloud Console で発行した OAuth クライアント (Web application) の JSON 全体
# Google Cloud Console → APIs & Services → Credentials → "OAuth 2.0 Client IDs" の
# 「JSONをダウンロード」したファイルの中身を1行JSONとして貼り付け。
# Authorized redirect URIs に  ${PUBLIC_BASE_URL}/oauth2/callback  を必ず登録すること。
GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"...","client_secret":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","redirect_uris":["http://localhost:8000/oauth2/callback"]}}

# 認可後にサーバが書き込む / 起動時に読むトークンファイル
GOOGLE_OAUTH_TOKEN_PATH=./google_token.json

# 連携する Google カレンダーの ID（通常は自分のメールアドレス、または "primary"）
HOST_CALENDAR_ID=primary
HOST_EMAIL=you@example.com
HOST_DISPLAY_NAME=ご担当者
HOST_TIMEZONE=Asia/Tokyo

# 予約フォームを開ける管理者ログインに使うシンプルなトークン
# /admin にこのトークンが乗ったURL（?token=xxx）でだけアクセスできる
ADMIN_TOKEN=change-me-to-a-long-random-string

# Google Maps Platform の APIキー（Distance Matrix API を有効化しておく）
GOOGLE_MAPS_API_KEY=ここにMaps APIキーを貼る
